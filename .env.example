# Cấu hình API Backend cho AIVES Mobile (React Native / Expo)
# Lưu ý: Khi chạy Backend (mvn spring-boot:run), URL Cloudflare Tunnel sẽ TỰ ĐỘNG được cập nhật vào file .env này!

# Tự động cập nhật bởi Backend (Cloudflare Quick Tunnel):
EXPO_PUBLIC_API_URL=https://<tên-ngẫu-nhiên>.trycloudflare.com/api

# Hoặc dùng thủ công nếu muốn:
# EXPO_PUBLIC_API_URL=https://<tên-máy>-8080.asse.devtunnels.ms/api
# EXPO_PUBLIC_API_URL=https://<ngrok-id>.ngrok-free.app/api
