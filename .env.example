# Cấu hình API Backend cho AIVES Mobile (React Native / Expo)
# Lưu ý: BẮT BUỘC phải dùng Tunnel (không dùng localhost vì điện thoại không đọc được localhost máy tính)

# Cách 1: Host Port trên VS Code (Ports tab -> Forward port 8080 -> Visibility Public)
# EXPO_PUBLIC_API_URL=https://<tên-máy>-8080.asse.devtunnels.ms/api

# Cách 2: Qua Ngrok (ngrok http 8080)
EXPO_PUBLIC_API_URL=https://<ngrok-id>.ngrok-free.app/api
